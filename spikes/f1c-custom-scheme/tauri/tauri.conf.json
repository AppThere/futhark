{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "futhark-f1c",
  "version": "0.0.0",
  "identifier": "dev.appthere.futhark.f1c",
  "build": {
    "frontendDist": "../probe"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Futhark Spike F1c — custom-scheme origin probe",
        "width": 1100,
        "height": 900,
        "url": "host.html?transport=custom-scheme&content=futhark-content://localhost"
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src futhark-content://localhost futhark-content: ; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
