  "cases": [
    {
      "id": "backstop-none",
      "csp": "default-src 'none'",
      "expect": {
        "externalScript": "deny",
        "inlineScript": "deny",
        "evalAllowed": "deny",
        "externalStyle": "deny",
        "image": "deny",
        "fetch": "deny",
        "xhr": "deny"
      },
      "note": "The whole sandbox rests on this one line.",
      "results": {
        "probeRan": false
      },
      "rows": [
        {
          "key": "externalScript",
          "want": "deny",
          "got": "blocked",
          "verdict": "ok"
        },
        {
          "key": "inlineScript",
          "want": "deny",
          "got": "unobservable",
          "verdict": "unobservable"
        },
        {
          "key": "evalAllowed",
