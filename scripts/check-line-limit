# Enforces the 300-line file ceiling on Rust sources.
# There is no escape hatch by design. Split the file.
set -euo pipefail

LIMIT="${LIMIT:-300}"
fail=0

while IFS= read -r -d '' f; do
    n=$(wc -l < "$f")
    if [ "$n" -gt "$LIMIT" ]; then
        printf '%s: %d lines (limit %d)\n' "$f" "$n" "$LIMIT" >&2
        fail=1
    fi
done < <(find crates shell conformance -name '*.rs' -type f -print0 2>/dev/null)

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "300-line ceiling exceeded. Split the file; do not raise the limit." >&2
    exit 1
fi
echo "line-limit: ok (limit ${LIMIT})"
