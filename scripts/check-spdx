#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Kevin Carlson
# SPDX-License-Identifier: Apache-2.0
#
# Every source file carries an SPDX header, with FileCopyrightText BEFORE
# License-Identifier. Ordering is part of the standard, not a preference.
set -euo pipefail

fail=0
check() {
    local f="$1" head
    head=$(head -n 5 "$f")
    if ! grep -q 'SPDX-FileCopyrightText' <<< "$head"; then
        printf '%s: missing SPDX-FileCopyrightText\n' "$f" >&2; fail=1; return
    fi
    if ! grep -q 'SPDX-License-Identifier' <<< "$head"; then
        printf '%s: missing SPDX-License-Identifier\n' "$f" >&2; fail=1; return
    fi
    local c l
    c=$(grep -n 'SPDX-FileCopyrightText' <<< "$head" | head -n1 | cut -d: -f1)
    l=$(grep -n 'SPDX-License-Identifier' <<< "$head" | head -n1 | cut -d: -f1)
    if [ "$c" -ge "$l" ]; then
        printf '%s: SPDX-FileCopyrightText must precede SPDX-License-Identifier\n' "$f" >&2
        fail=1
    fi
}

while IFS= read -r -d '' f; do check "$f"; done < <(
    find . \( -name '*.rs' -o -name 'Cargo.toml' -o -name '*.sh' \) \
         -not -path './target/*' -not -path './.git/*' -type f -print0)

[ "$fail" -eq 0 ] || { echo "" >&2; echo "SPDX header check failed." >&2; exit 1; }
echo "spdx: ok"
